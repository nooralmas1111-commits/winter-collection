# ===================================================
# FROST & FLAIR — Environment Configuration Template
# ===================================================

# 1. DATABASE_URL (Neon Pooled Connection for Application Runtime)
# Obtain from Neon Console -> Project Dashboard -> Connection Details -> Select "Pooled connection"
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_placeholder@ep-frost-flair-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. DIRECT_URL (Neon Direct Connection for Prisma Migrations)
# Obtain from Neon Console -> Project Dashboard -> Connection Details -> Uncheck "Connection pooling" (Direct)
# Format: postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL="postgresql://neondb_owner:npg_placeholder@ep-frost-flair.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 3. AUTH_SECRET (Cryptographic key for signing JWT tokens and session cookies)
# Generate via: openssl rand -base64 32
AUTH_SECRET="frost_flair_winter_luxury_secret_jwt_key_2026_super_secure_32b"

# 4. NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
